# Lodestar configuration. Copy to .env (start.bat does this on first run).
# Never share your .env file: it holds your API keys. Keys can also be entered in the app
# under Data providers, which writes them here.

# --- Alpaca Market Data (free account at https://alpaca.markets) -------------------------
# Paper-trading keys work for market data. Free plan: real-time IEX quotes, 200 requests/min.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Optional: Anthropic API key for AI-written narratives (https://console.anthropic.com) --
ANTHROPIC_API_KEY=

# --- Advanced (leave as-is unless you need to change them) ---------------------------------
# LODESTAR_PORT=8765
# LODESTAR_HOST=127.0.0.1          # keep 127.0.0.1 so the app is only reachable from this PC
# LODESTAR_DATA_DIR=              # defaults to the "data" folder next to this file
# Only when the website is hosted separately from the engine (see "Hosting the site" in README.md):
# LODESTAR_CORS_ORIGINS=https://your-site.example   # comma-separated
# LODESTAR_API_TOKEN=             # required before exposing the engine beyond this PC
